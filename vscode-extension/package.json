{
  "name": "flip-vscode",
  "displayName": "Flip - Personal Knowledge Management",
  "description": "VS Code integration for flip - your intelligent 2nd brain assistant",
  "version": "0.3.23",
  "publisher": "danorama",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "knowledge management",
    "notes",
    "journal",
    "second brain",
    "pkm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flip.journal",
        "title": "Flip: Open/Create Journal"
      },
      {
        "command": "flip.note",
        "title": "Flip: New Note"
      },
      {
        "command": "flip.quicknote",
        "title": "Flip: Quick Note"
      },
      {
        "command": "flip.meetingNote",
        "title": "Flip: New Meeting Note"
      },
      {
        "command": "flip.search",
        "title": "Flip: Search All Brains"
      },
      {
        "command": "flip.recentNotes",
        "title": "Flip: Recent Notes"
      },
      {
        "command": "flip.searchFiltered",
        "title": "Flip: Search with Filters"
      },
      {
        "command": "flip.status",
        "title": "Flip: Show Status"
      },
      {
        "command": "flip.aiStatus",
        "title": "Flip: AI Status"
      },
      {
        "command": "flip.aiResearch",
        "title": "Flip: AI Research"
      },
      {
        "command": "flip.aiSummarize",
        "title": "Flip: AI Summarize"
      },
      {
        "command": "flip.aiImprove",
        "title": "Flip: AI Improve Note"
      },
      {
        "command": "flip.aiSetup",
        "title": "Flip: AI Setup (Provider & Model)"
      },
      {
        "command": "flip.brainHealth",
        "title": "Flip: Brain Health Check"
      },
      {
        "command": "flip.brainRestore",
        "title": "Flip: Restore Orphaned Files"
      },
      {
        "command": "flip.brainRelocate",
        "title": "Flip: Relocate Brain to New Location"
      },
      {
        "command": "flip.mediaNormalize",
        "title": "Flip: Normalize Media"
      },
      {
        "command": "flip.export",
        "title": "Flip: Export Markdown"
      },
      {
        "command": "flip.exportDoctor",
        "title": "Flip: Check Export Dependencies"
      },
      {
        "command": "flip.switchBrain",
        "title": "Flip: Switch Brain"
      },
      {
        "command": "flip.taskNew",
        "title": "Flip: New Task"
      },
      {
        "command": "flip.taskStatus",
        "title": "Flip: Update Task Status"
      },
      {
        "command": "flip.taskDone",
        "title": "Flip: Mark Task as Done"
      },
      {
        "command": "flip.taskSearch",
        "title": "Flip: Search Tasks"
      },
      {
        "command": "flip.taskFrog",
        "title": "Flip: 🐸 Eat the Frog (Important Tasks)"
      },
      {
        "command": "flip.taskToday",
        "title": "Flip: Today's Tasks"
      },
      {
        "command": "flip.taskBrowse",
        "title": "Flip: 📋 Browse Tasks (WebView Panel)"
      },
      {
        "command": "flip.insertLink",
        "title": "Flip: Insert Link to Note"
      },
      {
        "command": "flip.addToJournal",
        "title": "Flip: Add Current File to Journal"
      },
      {
        "command": "flip.sync",
        "title": "Flip: Sync Brains"
      },
      {
        "command": "flip.quickSync",
        "title": "Flip: Quick Sync Brains"
      },
      {
        "command": "flip.syncAndPush",
        "title": "Flip: Sync Brains (Legacy Alias)"
      },
      {
        "command": "flip.addParticipants",
        "title": "Flip: Add Participants to Meeting"
      },
      {
        "command": "flip.journalSync",
        "title": "Flip: Journal Sync (Fehlende Einträge prüfen)"
      },
      {
        "command": "flip.definitions",
        "title": "Flip: Manage Definitions (Orgs/People/Contexts)"
      },
      {
        "command": "flip.addOrganization",
        "title": "Flip: Add Organization"
      },
      {
        "command": "flip.addPerson",
        "title": "Flip: Add Person"
      },
      {
        "command": "flip.exercises",
        "title": "Flip: Exercises (List & Track)"
      },
      {
        "command": "flip.newExercise",
        "title": "Flip: New Exercise"
      },
      {
        "command": "flip.quickTrack",
        "title": "Flip: Quick Track Exercise"
      },
      {
        "command": "flip.templates",
        "title": "Flip: Manage Templates"
      },
      {
        "command": "flip.editTemplate",
        "title": "Flip: Edit Template"
      },
      {
        "command": "flip.resetTemplate",
        "title": "Flip: Reset Template to Default"
      },
      {
        "command": "flip.insertTasks",
        "title": "Flip: Insert Tasks into Journal"
      },
      {
        "command": "flip.convertToNote",
        "title": "Flip: Convert File to Note"
      },
      {
        "command": "flip.about",
        "title": "Flip: About"
      },
      {
        "command": "flip.help",
        "title": "Flip: Help & Documentation"
      },
      {
        "command": "flip.manageBrains",
        "title": "Flip: Manage Brains"
      },
      {
        "command": "flip.listBrains",
        "title": "Flip: List Brains"
      },
      {
        "command": "flip.addBrain",
        "title": "Flip: Add Brain"
      },
      {
        "command": "flip.initBrain",
        "title": "Flip: Create New Brain"
      },
      {
        "command": "flip.removeBrain",
        "title": "Flip: Remove Brain"
      },
      {
        "command": "flip.setDefaultBrain",
        "title": "Flip: Set Default Brain"
      },
      {
        "command": "flip.manage",
        "title": "Flip: Manage (Settings, Cleanup, etc.)"
      },
      {
        "command": "flip.settings",
        "title": "Flip: Settings & Configuration"
      }
    ],
    "keybindings": [
      {
        "command": "flip.journal",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      },
      {
        "command": "flip.note",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "flip.quicknote",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q"
      },
      {
        "command": "flip.insertLink",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "flip.taskNew",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "flip.taskSearch",
        "key": "ctrl+shift+alt+t",
        "mac": "cmd+shift+alt+t"
      },
      {
        "command": "flip.taskFrog",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "flip.taskBrowse",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      },
      {
        "command": "flip.search",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "flip.recentNotes",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      },
      {
        "command": "flip.syncAndPush",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "configuration": {
      "title": "Flip",
      "properties": {
        "flip.executablePath": {
          "type": "string",
          "default": "flip",
          "description": "Path to flip executable (default: uses PATH)"
        },
        "flip.timeout": {
          "type": "number",
          "default": 10000,
          "description": "Timeout for flip commands in milliseconds"
        },
        "flip.aiTimeout": {
          "type": "number",
          "default": 180,
          "description": "Timeout for AI commands in seconds"
        },
        "flip.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show flip status in status bar"
        },
        "flip.export.defaultFormat": {
          "type": "string",
          "default": "pdf",
          "enum": [
            "pdf",
            "html",
            "docx"
          ],
          "description": "Default export format for Flip export command"
        },
        "flip.export.openAfterExport": {
          "type": "boolean",
          "default": true,
          "description": "Open exported files automatically after conversion"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/httrp/flip"
  }
}
