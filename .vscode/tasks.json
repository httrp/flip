    {
      "label": "Flip: Context-Aware Action",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "TYPE=$(flip file-info \"${file}\" --json 2>/dev/null | grep '\"type\"' | cut -d'\"' -f4); case \"$TYPE\" in exercise) flip exercise edit ;; plan) flip exercise plan edit ;; task) flip task done ;; note) flip task new ;; *) echo \"📄 File type: $TYPE\"; echo \"Available actions:\"; echo \"  • flip menu       - Open interactive menu\"; echo \"  • flip task new   - Create new task\"; echo \"  • flip note new   - Create new note\"; flip menu ;; esac"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
